{:paths ["src"]
 :tasks
 {:requires ([devkit.mono :as mono] [devkit.release :as release])
  mono:build {:doc "Build the monorepo from devkit main + the cleaned components. Opts: --out DIR (default .scratch/mono/devkit) --src DIR --devkit-ref REF --skip-missing"
              :task (mono/build! *command-line-args*)}
  release:collect {:doc "Build the two IntelliJ plugin zips from the generated monorepo in tmux window devkit-release -> .scratch/artifacts/ + manifest.edn. Opts: --repo DIR --detach"
                   :task (release/collect! *command-line-args*)}
  release:run {:doc "(inside the tmux window) the builds themselves"
               :task (release/run! *command-line-args*)}
  release:publish {:doc "Print (do not run) the gh release create commands. Opts: --org ORG (required) --repo NAME (default devkit) --tag TAG"
                   :task (release/publish! *command-line-args*)}}}
