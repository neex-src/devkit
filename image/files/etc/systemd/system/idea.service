[Unit]
Description=IntelliJ IDEA on the xpra display
After=xpra.service devkit-boot.service
Wants=xpra.service devkit-boot.service

[Service]
User=dev
WorkingDirectory=/work
Environment=HOME=/home/dev DISPLAY=:100 JAVA_HOME=/usr/lib/jvm/java-25-openjdk XDG_RUNTIME_DIR=/run/user/1000 CONTAINER_HOST=unix:///run/user/1000/podman/podman.sock DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
# DELIBERATOR_HOME, DEVKIT_WORK (devkit-boot wrote them)
EnvironmentFile=-/run/devkit.env
# The image's plugins are linked into the IDE's user plugin dir (the home is a volume) at every start.
ExecStartPre=/bin/sh -c 'mkdir -p ~/.local/share/JetBrains/IntelliJIdea2026.3 && for d in /opt/devkit/plugins/*; do ln -sfn $$d ~/.local/share/JetBrains/IntelliJIdea2026.3/; done'
ExecStartPre=/bin/sh -c 'for i in $$(seq 60); do xdotool getdisplaygeometry >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1'
ExecStart=/opt/idea/bin/idea.sh
Restart=always
RestartSec=3
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
