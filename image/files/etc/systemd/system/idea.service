[Unit]
Description=IntelliJ IDEA on the xpra display
After=xpra.service
Wants=xpra.service

[Service]
User=dev
WorkingDirectory=/work
Environment=HOME=/home/dev DISPLAY=:100 JAVA_HOME=/usr/lib/jvm/java-21-openjdk CONTAINER_HOST=unix:///run/host-podman.sock
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do xdotool getdisplaygeometry >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1'
ExecStart=/opt/idea/bin/idea.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
