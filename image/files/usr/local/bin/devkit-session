#!/usr/local/bin/bb
;; The desktop on the xpra display, started by xpra as its child.
;; xfce (the default): a window manager with NO keyboard shortcuts, so every key reaches IntelliJ, and a
;; panel to start things with the mouse. i3: the author's tiling setup; it takes Alt+digits.
;; Which one: /run/devkit/desktop when the menu wrote it, else DEVKIT_DESKTOP of /run/devkit.env (the
;; display's own unit does not take that file as its environment: its runtime folder is its own).
;; The desktops run in a loop:
;; the menu switches by writing the file and ending the running window manager; the IDE stays open.
(require '[babashka.fs :as fs] '[babashka.process :as p] '[clojure.string :as str])

(defn choice []
  (let [f "/run/devkit/desktop"
        d (str/trim (if (fs/exists? f)
                      (slurp f)
                      (or (second (re-find #"(?m)^DEVKIT_DESKTOP=(\S+)" (try (slurp "/run/devkit.env") (catch Exception _ "")))) "xfce")))]
    (if (= d "i3") "i3" "xfce")))

(defn quiet [& cmd] (apply p/shell {:continue true :out :string :err :string} cmd))

(defn sweep []
  (doseq [n ["xfwm4" "xfce4-panel" "xfsettingsd" "xfconfd" "i3" "i3bar" "i3status"]] (quiet "pkill" "-x" n)))

(def xfce
  ;; one dbus session for the parts; the window manager is the one waited for
  "xsetroot -solid '#1e1f22'; xfsettingsd >/dev/null 2>&1 & xfce4-panel >/dev/null 2>&1 & exec xfwm4 --compositor=off")

;; IntelliJ's project window fills the screen (xfce does not tile). Each window once, so it can be made
;; smaller by hand afterwards; dialogs and the Welcome window are left as they are.
(future
  (loop [seen #{}]
    (Thread/sleep 2000)
    (let [wins (for [l (str/split-lines (:out (quiet "wmctrl" "-lx")))
                     :let [[id _ cls _ & title] (str/split (str/trim l) #"\s+")]
                     :when (and cls (str/starts-with? cls "jetbrains-idea"))]
                 [id (str/join " " title)])
          fresh (remove (comp seen first) wins)]
      (doseq [[id title] fresh
              ;; a project window: IntelliJ gives it no window type at all; a dialog has one and belongs to a window
              :let [props (:out (quiet "xprop" "-id" id "_NET_WM_WINDOW_TYPE" "WM_TRANSIENT_FOR"))]
              :when (and (not (str/starts-with? title "Welcome"))
                         (not (re-find #"_NET_WM_WINDOW_TYPE_(DIALOG|UTILITY|SPLASH|MENU|TOOLTIP|POPUP_MENU|DROPDOWN_MENU|NOTIFICATION)" props))
                         (not (re-find #"WM_TRANSIENT_FOR\(WINDOW\)" props)))]
        (quiet "wmctrl" "-i" "-r" id "-b" "add,maximized_vert,maximized_horz"))
      (recur (into seen (map first fresh))))))

(loop []
  (sweep)
  (let [d (choice)]
    (println "devkit-session:" d)
    (if (= d "i3")
      (p/shell {:continue true} "i3")
      (p/shell {:continue true} "dbus-run-session" "--" "sh" "-c" xfce)))
  (Thread/sleep 500)
  (recur))
